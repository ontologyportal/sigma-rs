{
  "name": "@sigma/web",
  "version": "2.1.3",
  "private": true,
  "description": "SUMO browser -- the demo site over the sigmakee wasm engine.",
  "type": "module",
  "scripts": {
    "mirror": "node scripts/mirror.mjs",
    "predev": "npm run mirror",
    "dev": "npm-run-all -p dev:http dev:proxy",
    "dev:http": "wrangler pages dev --kv=SESSIONS --port 8443 -- vite",
    "dev:proxy": "local-ssl-proxy --source 8788 --target 8443",
    "prebuild": "npm run mirror",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.worker.json",
    "fmt": "prettier --write .",
    "clippy": "eslint ."
  },
  "dependencies": {
    "@sigma/language": "*",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "cytoscape-node-html-label": "^1.2.2",
    "monaco-editor": "^0.55.1",
    "sigmakee": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "local-ssl-proxy": "^2.0.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.12",
    "wrangler": "^4.126.0"
  }
}
