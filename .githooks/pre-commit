#!/usr/bin/env bash

# Colors (only when writing to a terminal)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GRE='\033[0;32m'
    DIM='\033[2m'
    NC='\033[0m'
else
    RED='' GRE='' DIM='' NC=''
fi

# Prompt on the controlling terminal (not stdin) — git commit may
# not have a normal stdin attached, e.g. when run from a GUI client.
if [ -r /dev/tty ]; then
    exec < /dev/tty
    read -r -p "Skip pre-commit checks? [y/N] " reply
    case "$reply" in
        [yY][eE][sS]|[yY]) exit 0 ;;
        *) echo "Running pre-commit tests" ;;
    esac
else
    # No interactive terminal available — can't prompt, so just warn
    echo "(No interactive terminal detected — proceeding with commit. Fix before opening the PR!)" >&2
    exit 0
fi

if [ -n "$SKIP_BUILD_CHECK" ]; then
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "⚠️  cargo not found in PATH — skipping pre-commit build/test check." >&2
    exit 0
fi

# Only run inside a Rust project
if [ ! -f "Cargo.toml" ]; then
    exit 0
fi

# Millisecond clock; perl (always present on macOS/Linux) gives sub-second
# resolution, bash 3.2 has no $EPOCHREALTIME.
now_ms() {
    perl -MTime::HiRes=time -e 'printf "%d\n", time*1000' 2>/dev/null || echo $(( $(date +%s) * 1000 ))
}

fmt_secs() {
    local ms=$1
    printf "%d.%01ds" $(( ms / 1000 )) $(( (ms % 1000) / 100 ))
}

step_no=0
failed_steps=""

# Rolling window height. 0 = plain streaming (used when stdout is not a
# terminal, since the redraw relies on cursor movement).
if [ -t 1 ]; then WINDOW=10; else WINDOW=0; fi

# stream_window STEP START_SECS
#
# Reads lines on stdin and shows only the last $WINDOW of them, redrawing
# in place so older lines scroll off the top. The sentinel line
# "__step_exit=N" (emitted by run_step) is recorded to $status_file
# instead of shown; when N is 0 the window is erased on exit so a
# successful step collapses to its header + DONE line.
stream_window() {
    local n=$1 start_s=$2
    local cols
    cols=$(tput cols 2>/dev/null || echo 80)
    cols=$(( cols - 1 ))
    local count=0 line status
    local buf=()

    while IFS= read -r line; do
        case "$line" in
            __step_exit=*) echo "$line" > "$status_file"; continue ;;
        esac
        line="${line//$'\t'/    }"
        line="$n $(( SECONDS - start_s ))s $line"
        line="${line:0:$cols}"

        if [ "$WINDOW" -eq 0 ]; then
            printf "${DIM}%s${NC}\n" "$line"
            continue
        fi

        [ "$count" -gt 0 ] && printf "\033[%dA\033[J" "$count"
        if [ "${#buf[@]}" -ge "$WINDOW" ]; then
            buf=("${buf[@]:1}" "$line")
        else
            buf=("${buf[@]}" "$line")
        fi
        count=${#buf[@]}
        printf "${DIM}%s${NC}\n" "${buf[@]}"
    done

    status=$(sed -n 's/^__step_exit=//p' "$status_file")
    if [ "$WINDOW" -gt 0 ] && [ "$count" -gt 0 ] && [ "${status:-1}" = 0 ]; then
        printf "\033[%dA\033[J" "$count"
    fi
}

# run_step LABEL CMD...
#
# Runs CMD with combined stdout/stderr through stream_window, docker-build
# style:
#
#   #3 [cargo build] env RUSTFLAGS=-D warnings cargo build --release
#   #3 12s    Compiling foo v0.1.0        <- last $WINDOW lines, live
#   #3 DONE 12.3s
#
# On failure the last $WINDOW lines stay on screen above an "#3 ERROR"
# line and LABEL is appended to $failed_steps.
run_step() {
    local label=$1; shift
    step_no=$(( step_no + 1 ))
    local n="#$step_no"
    local start start_s=$SECONDS
    start=$(now_ms)

    printf "\n${DIM}%s${NC} [%s] %s\n" "$n" "$label" "$*"

    : > "$status_file"
    (
        "$@" 2>&1
        echo "__step_exit=$?"
    ) | stream_window "$n" "$start_s"

    local status
    status=$(sed -n 's/^__step_exit=//p' "$status_file")
    local total=$(( $(now_ms) - start ))
    if [ "${status:-1}" = 0 ]; then
        printf "${DIM}%s${NC} ${GRE}DONE${NC} %s\n" "$n" "$(fmt_secs "$total")"
    else
        printf "${DIM}%s${NC} ${RED}ERROR${NC}: [%s] exited with code %s after %s\n" \
            "$n" "$label" "${status:-?}" "$(fmt_secs "$total")"
        failed_steps="$failed_steps $label"
    fi
}

status_file=$(mktemp)
trap 'rm -f "$status_file"' EXIT

run_step "cargo fmt"    cargo fmt --check
run_step "cargo clippy" cargo clippy --workspace --all-features --tests -- -D warnings
run_step "cargo build"  env RUSTFLAGS="-D warnings" cargo build --release
run_step "cargo test"   cargo test
run_step "cargo test lsp" cargo test -p sumo-lsp

# JavaScript/TypeScript workspace (packages/): prettier + eslint, via the
# root package.json scripts. Skipped when npm or node_modules is missing.
if command -v npm >/dev/null 2>&1 && [ -f "package.json" ] && [ -d "node_modules" ]; then
    run_step "prettier" npm run -s fmt:check
    run_step "eslint"   npm run -s lint
    run_step "web typecheck" npm run -s typecheck -w @sigma/web

    # Browser e2e (packages/web/e2e). Two prerequisites are builds rather
    # than checkouts -- the wasm package the demo imports, and Playwright's
    # browser -- so a missing one warns and skips instead of failing a
    # commit, the same way a missing cargo/npm does above.
    if [ ! -d "packages/sigmakee/dist" ]; then
        echo "⚠️  packages/sigmakee/dist not built — skipping web e2e." >&2
        echo "   Build it with: npm run build -w sigmakee" >&2
    elif ! node -e 'const {chromium} = require("playwright");
                    process.exit(require("fs").existsSync(chromium.executablePath()) ? 0 : 1)' \
            >/dev/null 2>&1; then
        echo "⚠️  Playwright's Chromium not installed — skipping web e2e." >&2
        echo "   Install it with: npx playwright install chromium" >&2
    else
        run_step "e2e smoke"         npm run -s test:e2e -w @sigma/web
        run_step "e2e kb-updates"    npm run -s test:e2e:kb-updates -w @sigma/web
        run_step "e2e edit-survival" npm run -s test:e2e:edit-survival -w @sigma/web
        run_step "e2e version-notes" npm run -s test:e2e:version -w @sigma/web

        # The Vampire suite needs the Emscripten build, which is gitignored
        # and takes minutes to produce -- run it only where it exists.
        if [ -d "packages/web/public/vampire" ]; then
            run_step "e2e vampire"   npm run -s test:e2e:vampire -w @sigma/web
        else
            echo "⚠️  packages/web/public/vampire not built — skipping the Vampire e2e." >&2
            echo "   Build it with: npm run build -w @sigma/vampire" >&2
        fi
    fi
else
    echo "⚠️  npm or node_modules not found — skipping prettier/eslint/typecheck/e2e checks." >&2
fi

echo ""
if [ -z "$failed_steps" ]; then
    printf "${GRE}All pre-commit checks passed.${NC}\n"
    exit 0
fi

printf "${RED}Failed checks:${NC}%s\n" "$failed_steps" >&2
echo "⚠️  Build and/or tests failed. This commit won't pass CI/PR checks as-is." >&2

# Prompt on the controlling terminal (not stdin) — git commit may
# not have a normal stdin attached, e.g. when run from a GUI client.
if [ -r /dev/tty ]; then
    exec < /dev/tty
    read -r -p "Commit anyway? [y/N] " reply
    case "$reply" in
        [yY][eE][sS]|[yY]) exit 0 ;;
        *) echo "Commit aborted. (Re-run with SKIP_BUILD_CHECK=1 to bypass this check entirely.)" >&2; exit 1 ;;
    esac
else
    # No interactive terminal available — can't prompt, so just warn
    echo "(No interactive terminal detected — proceeding with commit. Fix before opening the PR!)" >&2
    exit 0
fi
