{
  "name": "sigmakee",
  "version": "2.2.4",
  "description": "Load SUO-KIF, translate to TPTP, and prove theorems in-browser with the pure-Rust native saturation prover (sigmakee-rs).",
  "license": "GPL-3.0",
  "type": "module",
  "module": "./dist/engine.js",
  "types": "./dist/engine.d.ts",
  "exports": {
    ".": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.mjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.mjs"
    },
    "./engine_bg.wasm": "./dist/engine_bg.wasm",
    "./sumo_parser_wasm_bg.wasm": "./dist/engine_bg.wasm"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "docs": "typedoc",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "binaryen": "^132.0.0",
    "typedoc": "^0.28.20"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/engine.js"
  ],
  "keywords": [
    "sumo",
    "suo-kif",
    "kif",
    "tptp",
    "ontology",
    "theorem-prover",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://ontologyportal.github.io/sigma-rs/docs/js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ontologyportal/sigma-rs.git",
    "directory": "packages/sigmakee"
  },
  "bugs": {
    "url": "https://github.com/ontologyportal/sigma-rs/issues"
  }
}
