{
  "name": "@sigma/web",
  "version": "2.2.0",
  "private": true,
  "description": "SUMO browser -- the demo site over the sigmakee wasm engine.",
  "type": "module",
  "scripts": {
    "mirror": "node scripts/mirror.mjs",
    "predev": "npm run mirror && vite build",
    "dev": "npm-run-all -p dev:http dev:proxy",
    "dev:http": "wrangler pages dev --kv=SESSIONS --port 8443 -- vite",
    "dev:proxy": "local-ssl-proxy --source 8788 --target 8443",
    "dev:vite": "vite",
    "prebuild": "npm run mirror",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p . && tsc --noEmit -p tsconfig.worker.json",
    "fmt": "prettier --write .",
    "fmt:check": "prettier .",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "test:e2e": "node e2e/smoke.mjs",
    "test:e2e:vampire": "node e2e/vampire.mjs",
    "test:e2e:version": "node e2e/version-notes.mjs",
    "test:e2e:kb-updates": "node e2e/kb-update-prefs.mjs"
  },
  "dependencies": {
    "@sigma/language": "*",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "cytoscape-node-html-label": "^1.2.2",
    "dompurify": "^3.2.7",
    "marked": "^14.0.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^4.0.3",
    "sigmakee": "*",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@octokit/types": "^18.0.0",
    "local-ssl-proxy": "^2.0.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.12",
    "vscode-languageserver-protocol": "^3.18.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.126.0"
  }
}
