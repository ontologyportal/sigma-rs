{
  "name": "sigmakee",
  "version": "2.1.3",
  "description": "Load SUO-KIF, translate to TPTP, and prove theorems in-browser with the pure-Rust native saturation prover (sigmakee-rs).",
  "license": "GPL-3.0",
  "type": "module",
  "module": "./dist/sumo_parser_wasm.js",
  "types": "./dist/sumo_parser_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sumo_parser_wasm.d.ts",
      "default": "./dist/sumo_parser_wasm.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.mjs"
    },
    "./sumo_parser_wasm_bg.wasm": "./dist/sumo_parser_wasm_bg.wasm"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "binaryen": "^132.0.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/sumo_parser_wasm.js"
  ],
  "keywords": [
    "sumo",
    "suo-kif",
    "kif",
    "tptp",
    "ontology",
    "theorem-prover",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://github.com/ontologyportal/sigma-rs/tree/main/packages/sigmakee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ontologyportal/sigma-rs.git",
    "directory": "packages/sigmakee"
  },
  "bugs": {
    "url": "https://github.com/ontologyportal/sigma-rs/issues"
  }
}
