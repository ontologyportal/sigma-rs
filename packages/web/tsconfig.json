{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],

    // Pinia's options stores infer `this` correctly only under `strict`:
    // with it off, every `this.<state>` inside an action silently degrades to
    // `any` while `state()`'s own annotations still look right.
    "strict": true
  },
  "include": ["src", "vite.config.ts"],
  // sigma.worker.ts has its own config (tsconfig.worker.json): it runs in
  // a Worker global scope, not a window, and needs the WebWorker lib instead
  // of DOM.
  "exclude": ["node_modules", "dist", "functions", "src/worker/sigma.worker.ts"]
}
