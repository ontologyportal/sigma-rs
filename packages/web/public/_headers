# Cloudflare Pages response headers (ignored as a plain file everywhere else).
#
# COOP/COEP make the site cross-origin isolated, which is what grants
# SharedArrayBuffer to the pthreads-built vampire.wasm. GitHub Pages cannot
# send them, so the Vampire backend only works on the Cloudflare deploy.
#
# Cloudflare COMBINES the headers of every matching rule instead of letting the
# most specific one win: a `/*` fallback under an `/assets/*` override yields
# "public, max-age=31536000, immutable, no-cache" and the max-age is dead. The
# rules below are therefore non-overlapping -- keep them that way.

# Content-hashed filenames, so the URL is immutable by construction.
/assets/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: public, max-age=31536000, immutable

# Stable URLs: revalidate so a deploy is picked up on the next load.
# /:route covers index.html, logo.png, version.json, and the client-side routes
# (/edit, /diagnostics, ...) that the SPA fallback answers with index.html.
/
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-cache

/:route
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-cache

/vampire/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-cache
