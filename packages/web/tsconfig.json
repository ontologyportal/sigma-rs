{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],

    // This is a mechanical JS -> TS conversion of a previously untyped
    // codebase: no annotations were added, so full `strict` would surface
    // hundreds of pre-existing implicit-any / possibly-null findings unrelated
    // to this change. Tighten incrementally per-file as real types land.
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src", "vite.config.ts"],
  // sigma.worker.ts has its own config (tsconfig.worker.json): it runs in
  // a Worker global scope, not a window, and needs the WebWorker lib instead
  // of DOM.
  "exclude": ["node_modules", "dist", "functions", "src/sigma.worker.ts"]
}
